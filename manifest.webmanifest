{
  "name": "Field Instruments",
  "short_name": "Field Instruments",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#02040a",
  "theme_color": "#02040a",
  "description": "Premium neon-galaxy telemetry suite: Star Finder, Sound Level Meter, Vibration Analyzer, Magnetic Field Mapper, Barometric Altimeter. All data stays on your device.",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Star Finder",
      "short_name": "Stars",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }],
      "url": "./index.html#stars"
    },
    {
      "name": "Sound Level",
      "short_name": "Sound",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }],
      "url": "./index.html#sound"
    },
    {
      "name": "Vibration",
      "short_name": "Vibrate",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }],
      "url": "./index.html#vibration"
    },
    {
      "name": "Magnetic Field",
      "short_name": "Magnetic",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }],
      "url": "./index.html#magnetic"
    },
    {
      "name": "Altimeter",
      "short_name": "Altitude",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }],
      "url": "./index.html#altimeter"
    }
  ],
  "serviceworker": {
    "script": "sw.js"
  }
